#!/bin/sh
if [ "$1" = "--version" ]; then
  printf '2.1.198 (Claude Code)\n'
  exit 0
fi
if [ "$1" = "auth" ] && [ "$2" = "status" ]; then
  printf '{"loggedIn":true}\n'
  exit 0
fi
for argument in "$@"; do
  [ "$argument" = "--help" ] && exit 0
done
printf '{"structured_output":{"summary":"ok"}}\n'
